APP_NAME=Support Agent API
APP_VERSION=0.3.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SUPPORT_AGENT_DB_PATH=
SUPPORT_AGENT_API_KEYS=dev-support-key
SUPPORT_AGENT_REQUIRE_API_KEY=true
SUPPORT_AGENT_REQUEST_TIMEOUT_SECONDS=20
SUPPORT_AGENT_OPENAI_TIMEOUT_SECONDS=10
SUPPORT_AGENT_OPENAI_MAX_RETRIES=2
SUPPORT_AGENT_RATE_LIMIT_REQUESTS=10
SUPPORT_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
CHROMA_PERSIST_DIR=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Embedding model (sentence-transformers, supports Chinese)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# HuggingFace mirror for CN networks
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1
